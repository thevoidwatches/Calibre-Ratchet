/.notes
# undo files written by the maintenance scripts in .scripts/ —
# library-sized metadata dumps, regenerated on every apply
/.backups

# secrets — never commit these (the .example versions are the templates)
config.toml
personal.ini
.env

# local environment / runtime artifacts
.venv/
__pycache__/
*.pyc
*.sqlite3

# where your own server lives — the shell is built against one machine's
# tailnet address, which is yours rather than the project's. Copy the
# .example and put your address in it; build-error-page.mjs reads it from
# here so the offline page cannot disagree with the app about the address.
shell/capacitor.config.json
# generated from error.template.html + offline.js + offline.css, with that
# address baked in — a build artifact, and one machine's at that. Run
# `node build-error-page.mjs` before `npx cap copy android`.
shell/www/error.html

# native shell build artifacts (the android/ project itself is tracked)
shell/node_modules/
shell/android/.gradle/
shell/android/build/
shell/android/app/build/
shell/android/local.properties

# config/ describes one library rather than the project: what its tags are
# called, which spelling is right, which AO3 name means whom. The scripts and
# the service read it and are the same for everybody, so the code is tracked
# and the contents are not. See config/README.md.
/config/tag_rules.txt
/config/tag_scheme.toml
/config/ao3_names.txt
